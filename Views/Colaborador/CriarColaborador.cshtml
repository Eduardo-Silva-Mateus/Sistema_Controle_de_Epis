@model Controle_de_Epis.ViewModel.Colaborador.CriarColaboradorViewModel

@{
    ViewData["Title"] = "Criar Colaborador";
}
<div asp-validation-summary="All" class="text-danger"></div>
<h1>Criar Colaborador</h1>

<form asp-action="CriarColaborador" method="post">

    <div>
        <label asp-for="NomeColaborador">Nome:</label>
        <input asp-for="NomeColaborador" class="form-control" />
        <span asp-validation-for="NomeColaborador" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="CpfColaborador">Cpf:</label>
        <input asp-for="CpfColaborador" class="form-control" />
        <span asp-validation-for="CpfColaborador" class="text-danger"></span>
    </div>
    
    <div>
        <label asp-for="CargoColaborador">Cargo:</label>
        <input asp-for="CargoColaborador" class="form-control" type="text" />
        <span asp-validation-for="CargoColaborador" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="SetorColaborador">Setor:</label>
        <input asp-for="SetorColaborador" class="form-control" type="text" />
        <span asp-validation-for="SetorColaborador" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="AtivoColaborador" class="form-check-input" />
        <label asp-for="AtivoColaborador" class="form-check-label">
            Colaborador ativo
        </label>
    </div>

    <button type="submit">Criar Colaborador</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}