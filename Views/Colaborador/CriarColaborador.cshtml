@model Controle_de_Epis.ViewModel.UsuarioCreateViewModel

@{
    ViewData["Title"] = "Criar Colaborador";
}
<div asp-validation-summary="All" class="text-danger"></div>
<h1>Criar Colaborador</h1>

<form asp-action="CriarColaborador" method="post">

    <div>
        <label asp-for="Nome">Nome:</label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Cpf">Cpf:</label>
        <input asp-for="Cpf" class="form-control" />
        <span asp-validation-for="Cpf" class="text-danger"></span>
    </div>
    
    <div>
        <label asp-for="Cargo">Cargo:</label>
        <input asp-for="Cargo" class="form-control" type="text" />
        <span asp-validation-for="Cpf" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="SetorColaborador">Setor:</label>
        <input asp-for="ConfirmarSenha" class="form-control" type="password" />
        <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Ativo" class="form-check-input" />
        <label asp-for="Ativo" class="form-check-label">
            Usuário ativo
        </label>
    </div>

    <button type="submit">Criar Colaborador</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}