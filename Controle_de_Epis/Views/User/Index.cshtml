@using Controle_de_Epis.ViewModel
@model List<UsuarioListViewModel>

<h1>Listagem de Usuários</h1>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nome</th>
            <th scope="col">Email</th>
            <th scope="col">Perfil</th>
            <th scope="col">Ativo</th>
        </tr>
    </thead>
    <tbody>
        @if(Model != null && Model.Any())
        {
            foreach(UsuarioListViewModel usuario in Model)
            {
                <tr>
                    <td>@usuario.Id</td>
                    <td>@usuario.Nome</td>
                    <td>@usuario.Email</td>
                    <td>@usuario.Perfil</td>
                    <td>@(usuario.Ativo ? "Sim" : "Não")</td>
                    <td>
                        <div>
                            <a class="btn btn-primary" asp-controller="Usuario" asp-action="EditarUsuario" asp-route-id="@usuario.Id">Editar</a>
                            <a class="btn btn-danger" asp-controller="Usuario" asp-action="DeletarUsuarioConfirmacao" asp-route-id="@usuario.Id">Deletar</a>
                            <a class="btn btn-secondary" asp-controller="Usuario" asp-action="AlterarSenha" asp-route-id="@usuario.Id">Alterar Senha</a>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>